# Paste your Anthropic API key here to enable AI search + AI work scores.
# Without it, WorkSpot runs in local mode (keyword search + curated scores).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Public contact inbox used by the feedback + contact forms.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (dashboard: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SECRET_KEY=
